# ───────── 系统 / 环境 / 密钥(永不入库)─────────
.DS_Store
.env
.env.*
.current-run-id

# ───────── 工具与浏览器自动化临时输出(只挡仓库根目录,避免误伤 run 内 artifacts/outputs/)─────────
/outputs/
/trace-output/
.playwright-mcp/

# ───────── 私人飞书文档备份与一次性推送脚本(非作品内容,含私密文档 token,不入公开库)─────────
/对外文档-修订稿.md
recovery/
tools/feishu-*.mjs
tools/push-to-feishu.mjs
tools/fdump.py
feishu-video-uploads/

# ───────── 根目录飞书长截图(临时素材,已移至 ../trace-private)─────────
/full.jpeg
/hero.jpeg
/s5.jpeg

# ───────── 执行记录 runs/ ─────────
# 默认忽略全部 run;放行作品引用的三轮 run ＋ 三轮聚合结论作为可复查证据
runs/*
!runs/20260603-182255/
!runs/20260603-194724/
!runs/20260603-201612/
!runs/20260603-182255__20260603-194724__20260603-201612/

# 原始 trace 流体积大,默认忽略;显式放行这三轮各自的两份 trace
*.stream.jsonl
*.trace.jsonl
!runs/20260603-182255/opus/trace.stream.jsonl
!runs/20260603-182255/deepseek/trace.stream.jsonl
!runs/20260603-194724/opus/trace.stream.jsonl
!runs/20260603-194724/deepseek/trace.stream.jsonl
!runs/20260603-201612/opus/trace.stream.jsonl
!runs/20260603-201612/deepseek/trace.stream.jsonl

# ───────── run 内大二进制产物（体积控制）─────────
# grader 只 stat final-video.mp4、图片/音频只读 manifest 计数;故挡音频/中间视频/图,只保留最终成片
runs/**/*.mp3
runs/**/*.wav
runs/**/*.png
runs/**/*.mp4
!runs/**/final-video.mp4
